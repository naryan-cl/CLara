SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im13b25hc3N3cGxkc2JpdXlsd2tjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTM0MDk0NywiZXhwIjoyMTAwOTE2OTQ3fQ.eco2biTfkjlo_QZWE2ttEfjK73fHcoOodHoFfKGJDEA

# Optional — for running SQL migrations from the CLI (Session/pooler connection string)
# Dashboard → Connect → Session mode
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# App
# Local: http://localhost:3000
# Production: https://clara-cl.vercel.app  (or custom domain — no trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI (server-side only — never NEXT_PUBLIC_)
# Needed for: Whisper (CLara Listens), embeddings, Ask CLara, OKF extraction
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional chat/extraction model (Ask CLara / OKF); change when you lock a model
# OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Inngest (background jobs: process uploads, rebuild graph, etc.)
# Dashboard → https://app.inngest.com → your app → Keys
# App id in code: "clara" (src/lib/inngest/client.ts)
# Local: npm run dev  +  npm run inngest:dev  (second terminal)
# Production sync URL: https://clara-cl.vercel.app/api/inngest
# Health probe (booleans only): https://clara-cl.vercel.app/api/inngest/health
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional override if serve URL differs from NEXT_PUBLIC_APP_URL
# INNGEST_SERVE_ORIGIN=https://clara-cl.vercel.app

# -----------------------------------------------------------------------------
# Ops (later)
# Generate a random secret for any Vercel cron / internal routes
# CRON_SECRET=
