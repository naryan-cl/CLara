# CLara platform — environment template
# Copy to `.env.local` for local development:
#   copy .env.example .env.local
# Never commit `.env.local` or any filled env file — this repo may be public.
# Add the same keys in Vercel → Project → Settings → Environment Variables.
#
# PLACEHOLDERS ONLY below. Do not paste real keys into this file.

# -----------------------------------------------------------------------------
# Supabase (required for auth + database)
# Dashboard → Project Settings → API Keys
#
# 2026-07-29 incident: real keys were committed here and pushed to this public
# repo. Fix: legacy JWT-based API keys (anon + service_role) were DISABLED in
# Supabase, so those old values are dead regardless. This project now uses only
# the newer Publishable / Secret key system — use those going forward, and
# never paste real values into this file (only .env.local / Vercel env vars).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
# Only needed for privileged server-side work (bypasses RLS). Use a Secret API
# key (sb_secret_...) if/when that's actually required — do not re-enable
# legacy JWT keys.
# SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Optional — for running SQL migrations from the CLI (Session/pooler connection string)
# Dashboard → Connect → Session mode
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# App
# Local: http://localhost:3000
# Production: https://clara-cl.vercel.app  (or custom domain — no trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI (server-side only — never NEXT_PUBLIC_)
# Needed for: Whisper (CLara Listens), embeddings, Ask CLara, OKF extraction
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional chat/extraction model (Ask CLara / OKF); change when you lock a model
# OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Inngest (background jobs: process uploads, rebuild graph, etc.)
# Dashboard → https://app.inngest.com → your app → Keys
# App id in code: "clara" (src/lib/inngest/client.ts)
# Local: npm run dev  +  npm run inngest:dev  (second terminal)
# Production sync URL: https://clara-cl.vercel.app/api/inngest
# Health probe (booleans only): https://clara-cl.vercel.app/api/inngest/health
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional override if serve URL differs from NEXT_PUBLIC_APP_URL
# INNGEST_SERVE_ORIGIN=https://clara-cl.vercel.app

# -----------------------------------------------------------------------------
# Ops (later)
# Generate a random secret for any Vercel cron / internal routes
# CRON_SECRET=
