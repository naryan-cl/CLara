# CLara platform — environment template
# Copy to `.env.local` for local development:
#   copy .env.example .env.local
# Never commit `.env.local`. Add the same keys in Vercel → Project → Settings → Environment Variables.

# -----------------------------------------------------------------------------
# Supabase (required for auth + database)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — for running SQL migrations from the CLI (Session/pooler connection string)
# Dashboard → Connect → Session mode
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# App
# Local: http://localhost:3000
# Production: https://your-app.vercel.app  (or custom domain — no trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI (server-side only — never NEXT_PUBLIC_)
# Needed for: Whisper (CLara Listens), embeddings, Ask CLara, OKF extraction
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional chat/extraction model (Ask CLara / OKF); change when you lock a model
# OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Inngest (background jobs: process uploads, rebuild graph, etc.)
# Dashboard → https://app.inngest.com → your app → Keys
# Local optional: npm run inngest:dev  (once the package + /api/inngest route exist)
# Production sync URL: https://YOUR_DOMAIN/api/inngest
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional override if serve URL differs from NEXT_PUBLIC_APP_URL
# INNGEST_SERVE_ORIGIN=https://YOUR_DOMAIN

# -----------------------------------------------------------------------------
# Ops (later)
# Generate a random secret for any Vercel cron / internal routes
# CRON_SECRET=
