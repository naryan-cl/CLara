# CLara platform — environment template
# Copy to `.env.local` for local development:
#   copy .env.example .env.local
# Never commit `.env.local` or any filled env file — this repo may be public.
# Add the same keys in Vercel → Project → Settings → Environment Variables.
#
# PLACEHOLDERS ONLY below. Do not paste real keys into this file.

# -----------------------------------------------------------------------------
# Supabase (required for auth + database)
# Dashboard → Project Settings → API Keys
#
# 2026-07-29 incident: real keys were committed here and pushed to this public
# repo. Fix: legacy JWT-based API keys (anon + service_role) were DISABLED in
# Supabase, so those old values are dead regardless. This project now uses only
# the newer Publishable / Secret key system — use those going forward, and
# never paste real values into this file (only .env.local / Vercel env vars).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
# Required for backend-only privileged writes (bypasses RLS) — used by Inngest
# functions (e.g. OKF enrichment) that run with no signed-in user attached.
# Generate under Project Settings → API Keys → Secret keys. Never expose this
# to the browser (no NEXT_PUBLIC_ prefix) and never re-enable legacy JWT keys.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Optional — for running SQL migrations from the CLI (Session/pooler connection string)
# Dashboard → Connect → Session mode
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# App
# Local: http://localhost:3000
# Production: https://clara-cl.vercel.app  (or custom domain — no trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Auth URL Configuration (Dashboard → Authentication → URL Configuration)
# Required so Google SSO / magic links return to the right host after login.
#
# Site URL (keep production only):
#   https://clara-cl.vercel.app
#
# Redirect URLs allowlist (add all that apply):
#   http://localhost:3000/**
#   https://clara-cl.vercel.app/**
#   https://*-cultivatingleadership.vercel.app/**
#
# The Vercel preview wildcard is required: login uses window.location.origin as
# redirectTo. If the preview URL is not allowlisted, Supabase falls back to
# Site URL and SSO lands on production instead of the preview deploy.
# Team slug = Vercel team URL slug (Settings → General). Adjust if the team renames.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# OpenAI (server-side only — never NEXT_PUBLIC_)
# Needed for: Whisper (CLara Listens), embeddings, Ask CLara, OKF extraction
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Default: speakers + timestamps. Use whisper-1 for timestamp-only (no diarize).
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Optional chat/extraction model (Ask CLara / OKF / speaker-name mapping)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Ask CLara — encrypt per-stream API keys (Admin → Ask model)
# -----------------------------------------------------------------------------
# Only needed when a stream admin saves a custom OpenAI / Claude / Gemini key
# in Admin. Platform default uses OPENAI_API_KEY above and does NOT need this.
#
# What it does: AES-256-GCM encryption before keys are stored in Supabase.
# It is a server-only secret — never NEXT_PUBLIC_, never commit the real value.
#
# Generate once (64 hex characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Local: paste into .env.local as ASK_LLM_CREDENTIALS_KEY=<hex> then restart dev.
# Vercel: Settings → Environment Variables → Production (+ Preview if needed)
#         → Redeploy after adding.
#
# If you rotate this key, existing saved Ask API keys cannot be decrypted —
# stream admins must re-enter them in Admin → Ask model.
# ASK_LLM_CREDENTIALS_KEY=

# -----------------------------------------------------------------------------
# Inngest (background jobs: process uploads, rebuild graph, etc.)
# Dashboard → https://app.inngest.com → your app → Keys
# App id in code: "clara" (src/lib/inngest/client.ts)
# Local: npm run dev  +  npm run inngest:dev  (second terminal)
# Production sync URL: https://clara-cl.vercel.app/api/inngest
# Health probe (booleans only): https://clara-cl.vercel.app/api/inngest/health
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional override if serve URL differs from NEXT_PUBLIC_APP_URL
# INNGEST_SERVE_ORIGIN=https://clara-cl.vercel.app

# Local dev only — without this, /api/inngest assumes production/cloud mode
# and rejects the local Inngest dev server with 500s ("no signing key found").
# Do NOT set this in Vercel/production.
INNGEST_DEV=1

# -----------------------------------------------------------------------------
# Ops (later)
# Generate a random secret for any Vercel cron / internal routes
# CRON_SECRET=
